{
  "name": "@limwa/pi-opencode-gateway-provider",
  "version": "0.1.1",
  "description": "OpenCode Gateway model provider for the Pi coding agent",
  "keywords": [
    "pi-package",
    "pi-extension",
    "opencode",
    "llm",
    "gateway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limwa/pi-opencode-gateway-provider.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude tests/opencode-differential.spec.ts",
    "test:opencode": "vitest run tests/opencode-differential.spec.ts",
    "test:coverage": "vitest run --coverage --exclude tests/opencode-differential.spec.ts",
    "verify": "npm run format:check && npm run check && npm test && npm run build",
    "verify:upstream": "npm run verify && npm run test:opencode",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "effect": "4.0.0-rc.109",
    "execa": "10.0.1",
    "jose": "6.2.9",
    "remeda": "2.40.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.1 <1",
    "@earendil-works/pi-coding-agent": ">=0.84.1 <1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "prettier": "3.9.10",
    "rimraf": "6.1.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.5": true,
    "msgpackr-extract@3.0.4": true
  }
}
